-pub fn set_icon(class: &str, pid: i32, image: &Image) {
+/// Sets the icon for a client. Returns whether a real icon was found (not the
+/// generic fallback, and not a name the icon theme cannot resolve).
+pub fn set_icon(class: &str, pid: i32, image: &Image) -> bool {
+    set_icon_inner(class, pid, image);
+    image_resolves(image)
+}
+
+fn image_resolves(image: &Image) -> bool {
+    match image.storage_type() {
+        ImageType::IconName => image.icon_name().is_some_and(|name| {
+            name != "application-x-executable"
+                && Display::default().is_some_and(|d| IconTheme::for_display(&d).has_icon(&name))
+        }),
+        ImageType::Empty => false,
+        _ => true,
+    }
+}
+
+fn set_icon_inner(class: &str, pid: i32, image: &Image) {
     let image = image.clone();
     let _span = debug_span!("icon", class = class).entered();
 
